# Modèle de configuration : copier vers .env puis remplacer chaque valeur factice.
# Ne jamais commiter de valeur réelle.

# Base Postgres utilisée par l'application (connexion poolée).
DATABASE_URL=postgresql://utilisateur:motdepasse@hote/base?sslmode=require
# Connexion directe à la même base, utilisée par Prisma pour les migrations.
DIRECT_URL=postgresql://utilisateur:motdepasse@hote/base?sslmode=require

# Clé de signature de Better Auth et du cookie de l'espace bénévoles (longue chaîne aléatoire).
BETTER_AUTH_SECRET=remplacer-par-une-longue-chaine-aleatoire
# URL publique du site, côté serveur, pour Better Auth.
BETTER_AUTH_URL=http://localhost:3000
# Même URL, exposée au navigateur pour le client Better Auth.
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Clé d'API Resend pour l'envoi des courriels.
RESEND_API_KEY=re_xxx
# Adresse d'expédition des courriels (domaine vérifié chez Resend).
RESEND_FROM_EMAIL=expediteur@example.com

# Jeton Vercel Blob pour l'envoi des images (lu par @vercel/blob).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Jeton GitHub qui déclenche le workflow de synchronisation depuis l'admin.
GITHUB_TOKEN=github_pat_xxx
# Dépôt qui porte ce workflow, au format proprietaire/depot.
GITHUB_REPO=proprietaire/depot

# URL publique utilisée pour les liens de partage des articles.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Active les tâches planifiées en développement (toujours actives en production).
ENABLE_CRON=false

# ADMIN_EMAIL et ADMIN_PASSWORD ne vont pas ici : ils se passent seulement sur la ligne
# de commande de scripts/admin-mot-de-passe.ts (voir README.md).
